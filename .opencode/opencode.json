          "git show-ref *": "allow",
          "git rev-parse *": "allow",
          "git config --get user.name": "allow",
          "git config --get user.email": "allow",
          "sleep *": "allow",
          "terraform init": "allow",
          "terraform init *": "allow",
          "terraform plan": "allow",
          "terraform plan *": "allow",
          "terraform validate": "allow",
          "terraform validate *": "allow"
