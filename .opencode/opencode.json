{
  "$schema": "https://opencode.ai/config.json",
  "username": "Jiyeol Lee",
  "default_agent": "primary/plan",
  "autoupdate": false,
  "lsp": false,
  "provider": {
    "opencode-go": {
      "models": {
        "kimi-k3": {
          "variants": {
            "max": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "high"
            },
            "high": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "permission": {
    "mcp__*": "deny",
    "tool__*": "deny",
    "doom_loop": "allow",
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow"
    },
    "skill": {
      "*": "deny"
    }
  },
  "instructions": ["AGENTS.md"],
  "mcp": {
    "mcp__context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "mcp__aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws"
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "primary/plan": {
      "mode": "primary",
      "prompt": "{file:./prompts/agent/primary/plan.md}",
      "permission": {
        "bash": {
          "*": "ask",
          "rg *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "ls *": "allow",
          "echo *": "allow",
          "jq": "allow",
