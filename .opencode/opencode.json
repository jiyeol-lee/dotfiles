        "glob": "allow",
        "grep": "allow",
        "patch": "deny",
        "todowrite": "allow",
        "todoread": "allow",
        "webfetch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "subagent/explore": "allow"
        },
        "skill": {
          "grill-me": "allow",
