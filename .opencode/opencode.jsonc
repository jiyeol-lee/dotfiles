{
  "$schema": "https://opencode.ai/config.json",
  "username": "Jiyeol Lee",
  "default_agent": "software-engineer",
  "small_model": "opencode-go/claude-haiku-5-5#none",
  "update": "notify",
  "formatter": true,
  "websearch": {
    "provider": "exa",
  },
  "plugins": ["-opencode.provider.openai-context-caps"],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:python *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:python3 *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:node *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:awk *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:sed *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "shell:perl *",
      "effect": "deny",
    },
    {
      "action": "tool.use",
      "resource": "read:.env",
      "effect": "deny",
    },
  ],
  "permissions": [
    {
      "action": "tool__*",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/agentic-coding-tool/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/dev/**",
      "effect": "ask",
    },
    {
      "action": "external_directory",
      "resource": "~/dotfiles/.opencode/**",
      "effect": "ask",
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "skill",
      "resource": "unslop",
      "effect": "allow",
    },
    {
      "action": "skill",
      "resource": "guidelines",
      "effect": "allow",
    },
    {
      "action": "skill",
      "resource": "technical-design",
      "effect": "allow",
    },
  ],
  "instructions": ["AGENTS.md"],
  "references": {
    "opencode-settings": {
      "path": "~/dotfiles/.opencode",
    },
  },
  "mcp": {
    "servers": {
      "mcp__context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "mcp__aws-knowledge": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws",
      },
      "mcp__browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update",
        },
      },
    },
  },
  "agents": {
    "plan": {
      "disabled": true,
    },
    "build": {
      "disabled": true,
    },
    "general": {
      "disabled": true,
    },
    "software-engineer": {
      "mode": "primary",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask",
        },
        {
          "action": "shell",
          "resource": "http-sever *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "echo *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "jq",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "pwd *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git branch --show-current",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git merge-base *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git ls-files",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git ls-files *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git show-ref *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git rev-parse *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git rev-list *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git config --get user.name",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git config --get user.email",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "go build *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "go test *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "go vet *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "go fmt *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "gofmt *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "sleep *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu init",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu init *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu plan",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu plan *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu validate",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu validate *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu fmt",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "tofu fmt *",
          "effect": "allow",
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "patch",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "todoread",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "generator",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "evaluator",
          "effect": "allow",
        },
        {
          "action": "skill",
          "resource": "grill-me",
          "effect": "allow",
        },
        {
          "action": "skill",
          "resource": "pull-request",
          "effect": "allow",
        },
        {
          "action": "tool__gh--retrieve-repository-collaborators",
          "resource": "*",
          "effect": "allow",
        },
      ],
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns (eg. \"src/components /**/*.tsx\"), search code for keywords (eg. \"API endpoints\"), or answer questions about the codebase (eg. \"how do API endpoints work?\"). When calling this agent, specify the desired thoroughness level: \"quick\" for basic searches, \"medium\" for moderate exploration, or \"very thorough\" for comprehensive analysis across multiple locations and naming conventions.",
      "model": "opencode-go/claude-haiku-5-5#medium",
      "mode": "subagent",
      "hidden": true,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "patch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "todoread",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny",
        },
      ],
    },
    "generator": {
      "description": "Implements a bounded, independently scoped code or content change. Use during an authorized implementation-only request when the work can run in parallel without unresolved shared decisions or overlapping edits. Do not use for sequential or tightly coupled work.",
