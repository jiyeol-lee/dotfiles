{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "template": "\uf07c {{ .Path }} ",
          "properties": {
            "style": "mixed"
          },
          "foreground": "#A6E22E"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FF9F43",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }} ",
          "options": {
            "branch_icon": "\ue725 "
          }
        },
        {
          "type": "aws",
          "style": "plain",
          "template": "\ue7ad {{ if .Env.AWS_PROFILE }}{{ .Env.AWS_PROFILE }}{{ end }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "cache": {
            "duration": "1h",
            "strategy": "session"
          },
          "foreground": "#FF9900"
        },
        {
          "type": "kubectl",
          "style": "plain",
          "template": "\u2388 {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} ",
          "cache": {
            "duration": "1m",
            "strategy": "session"
          },
          "foreground": "#326CE5"
        },
        {
          "type": "terraform",
          "style": "plain",
          "template": "\ue8bd {{ .WorkspaceName }} ",
          "options": {
            "command": "tofu"
          },
          "cache": {
            "duration": "5m",
            "strategy": "folder"
          },
          "foreground": "#8E54C8"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "template": "\uf017 {{ .CurrentDate | date .Format }}",
          "foreground": "#D1A3E2"
        }
      ]
    }
  ]
}
