#!/usr/bin/env bash

# Increase Bash history size. the default is 500.
export HISTSIZE='32768'
export HISTFILESIZE="${HISTSIZE}"

# Omit duplicates and commands that begin with a space from history.
export HISTCONTROL='ignoreboth'

# opencode
export PATH=/home/jiyeollee/.opencode/bin:$PATH

# Change default editor to neovim
export EDITOR=nvim

if [ -f "/opt/homebrew/bin/brew" ]; then
  # nodejs 24
  export LDFLAGS="-L/opt/homebrew/opt/node@24/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/node@24/include"
  export PATH="/opt/homebrew/opt/node@24/bin:$PATH"

  # bash
  export PATH="/opt/homebrew/bin/bash:$PATH"
fi

export PODMAN_COMPOSE_WARNING_LOGS=false

if [ -z "$XDG_CONFIG_HOME" ]; then
  export XDG_CONFIG_HOME="$HOME/.config"
  mkdir -p "$XDG_CONFIG_HOME"
fi
if [ -z "$XDG_DATA_HOME" ]; then
  export XDG_DATA_HOME="$HOME/.local/share"
  mkdir -p "$XDG_DATA_HOME"
fi
if [ -z "$XDG_STATE_HOME" ]; then
  export XDG_STATE_HOME="$HOME/.local/state"
  mkdir -p "$XDG_STATE_HOME"
fi
if [ -z "$XDG_CACHE_HOME" ]; then
  export XDG_CACHE_HOME="$HOME/.cache"
  mkdir -p "$XDG_CACHE_HOME"
fi
if [ -z "$XDG_RUNTIME_DIR" ]; then
  export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/runtime-$UID"
  (umask 0077 && mkdir -p "$XDG_RUNTIME_DIR")
fi

TEMP_TTL=18000 # 5 hours in seconds

# Function to temp command output with TTL
temp_command() {
  local temp_file="$1"
  local ttl="$2"
  local command="$3"
  local result mtime now

  if [ -f "$temp_file" ]; then
    case "$(uname -s)" in
    Darwin)
      mtime=$(stat -f %m "$temp_file")
      ;;
    Linux)
      mtime=$(stat -c %Y "$temp_file")
      ;;
    esac
    now=$(date +%s)
    if [ $((now - mtime)) -lt "$ttl" ]; then
      cat "$temp_file"
      return
    fi
  fi

  result="$(eval "$command")"
  if [ -n "$result" ]; then
    echo "$result" >"$temp_file"
    chmod 600 "$temp_file"
    echo "$result"
  fi
}

if command -v go &>/dev/null; then
  # Add go path to PATH
  GO_BIN="$(temp_command "$XDG_RUNTIME_DIR/go_bin_path" "$TEMP_TTL" "go env GOPATH")/bin"
  export PATH="$PATH:$GO_BIN"
fi

if _pass_value="$(pass show google/oauth/client_id 2>/dev/null)"; then
  GOOGLE_CLIENT_ID="${_pass_value%%$'\n'*}"
  export GOOGLE_CLIENT_ID
fi

if _pass_value="$(pass show google/oauth/client_secret 2>/dev/null)"; then
  GOOGLE_CLIENT_SECRET="${_pass_value%%$'\n'*}"
  export GOOGLE_CLIENT_SECRET
fi

if _pass_value="$(pass show opencode/api_key 2>/dev/null)"; then
  OPENCODE_GO_API_KEY="${_pass_value%%$'\n'*}"
  export OPENCODE_GO_API_KEY
fi

if _pass_value="$(pass show exa/api_key 2>/dev/null)"; then
  EXA_API_KEY="${_pass_value%%$'\n'*}"
  export EXA_API_KEY
fi

if _pass_value="$(pass show cloudflare/account_id 2>/dev/null)"; then
  CLOUDFLARE_ACCOUNT_ID="${_pass_value%%$'\n'*}"
  export CLOUDFLARE_ACCOUNT_ID

  export AWS_ENDPOINT_URL_S3="https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
  if _pass_value="$(pass show cloudflare/admin/s3_access_key_id 2>/dev/null)"; then
    AWS_ACCESS_KEY_ID="${_pass_value%%$'\n'*}"
    export AWS_ACCESS_KEY_ID
  fi

  if _pass_value="$(pass show cloudflare/admin/s3_secret_access_key 2>/dev/null)"; then
    AWS_SECRET_ACCESS_KEY="${_pass_value%%$'\n'*}"
    export AWS_SECRET_ACCESS_KEY
  fi
fi

if _pass_value="$(pass show cloudflare/admin/api_token 2>/dev/null)"; then
  CLOUDFLARE_API_TOKEN="${_pass_value%%$'\n'*}"
  export CLOUDFLARE_API_TOKEN
fi

if _pass_value="$(pass show openai/stt_api_key 2>/dev/null)"; then
  OPENAI_API_KEY="${_pass_value%%$'\n'*}"
  export OPENAI_API_KEY
fi

unset _pass_value

unset -f temp_command
