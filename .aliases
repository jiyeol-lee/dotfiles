#!/usr/bin/env bash

# General
### neoVim
alias v='nvim'
### Tmux
alias t='tmux'
### Clear
alias c='clear'
### go to previous directory
alias ..='cd ..'
### do not turn off the screen
alias cafe='caffeinate -dims'
### List files in Long format with human-readable file sizes and colorized output
alias ll='ls -hl --color=auto'
### Display disk Usage in Human-readable format, depth 1, sorted by size
alias duh='du -h -d 1 | sort -hr'
### Brew Update and Upgrade with cask
alias buu='brew update && brew upgrade -g'
### LazyGit
alias lg='lazygit'

# OpenSSL
### OpenSsl Random String, pass n as length in bytes (turns into 2n hex characters)
alias osrs='openssl rand -hex'

# Opencode (AI)
### Open opencode in current directory
oc() {
  command opencode "$@"
  local -i code=$?
  ~/dotfiles/scripts/tmux_opencode_pane_strip.sh
  return $code
}
### OpenCode Stats
alias ocs='~/dotfiles/scripts/opencode_period_stats.sh'

# AWS
### AWs SSO Login
alias awssol='aws sso login --profile '
### aws Select Profile
alias awsp='source ~/dotfiles/scripts/aws_select_profile.sh'

# Vaults
### Change directory to Vault Personal
alias cvp='cd ~/vaults/vpersonal'
### Change directory to Vault Work 2
alias cvw2='cd ~/vaults/vwork2'
### Change directory to Vault Work 3
alias cvw3='cd ~/vaults/vwork3'

# Config/Dotfiles
### Change directory to Config folder
alias cc='cd ~/dotfiles'
### shell ReLoad zshrc
alias rlc='source ~/.zshrc'

# Podman
### Podman System Prune (all, volumes)
alias psp='podman system prune -a --volumes'
### Podman Machine Init
alias pmi='podman machine init --cpus=4 --memory=8192 --disk-size=50'
### Podman Machine Remove
alias pmr='podman machine rm'
### Podman Machine Start
alias pms='podman machine start'
### Podman Machine sTop
alias pmt='podman machine stop'

# Git, Github
## Git Remote Prune Origin (and cleanup gone branches)
grpo() {
  ### Git Remote Prune Origin and delete local branches with gone upstream
  git remote prune origin
  git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads |
    awk '$2 == "[gone]" {print $1}' |
    xargs git branch -D
}
## Git Switch User
alias gsu='gh auth switch && gh auth setup-git'
## Git Worktree Sandbox
gws() {
  ### Create sandbox worktree (-s for sandbox prefix, -n for new tmux window)
  # shellcheck source=scripts/git_worktree_sandbox.sh
  source ~/dotfiles/scripts/git_worktree_sandbox.sh "$@"
}
# Terraform
### TerraForm
alias tf='terraform'
### TerraForm Init
alias tfi='terraform init'
### TerraForm Plan
alias tfp='terraform plan'
### TerraForm Format
alias tff='terraform fmt'
### TerraForm Validate
alias tfv='terraform validate'
### Terraform Workspace List
alias tfwl='terraform workspace list'
### Terraform Workspace Select
alias tfws='terraform workspace select'

# Go
### Go Run
alias gr='go run'
### Go Run Main
alias grm='go run main.go'
### Go Run Dot
alias grd='go run .'
### Go Test All
alias gta='go test ./...'
