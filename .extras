#!/usr/bin/env bash

if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init "$(basename "$SHELL")" --config 'https://raw.githubusercontent.com/jiyeol-lee/dotfiles/main/shell_style.omp.json')"
fi
